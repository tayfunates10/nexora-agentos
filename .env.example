# Local development only. Copy to .env and choose a password before Compose startup.
POSTGRES_PASSWORD=replace-with-a-local-password

# OIDC: uncomment after registering a confidential web client with your provider.
# Callback must match exactly: <NEXORA_WEB_ORIGIN>/auth/callback
# NEXORA_WEB_ORIGIN=http://localhost:3000
# NEXORA_AUTH_ISSUER=https://your-provider.example/realm
# NEXORA_AUTH_AUDIENCE=nexora-api
# NEXORA_OIDC_CLIENT_ID=your-web-client-id
# NEXORA_OIDC_CLIENT_SECRET=replace-locally-never-commit
# The API discovers <issuer>/.well-known/openid-configuration and rotates RS256 JWKS keys.
# Set NEXORA_AUTH_PUBLIC_KEY only to deliberately pin one RSA public PEM.
# Cross-origin JWKS endpoints require explicit NEXORA_AUTH_JWKS_URL=https://...
# Authenticated API traffic is limited per verified issuer+subject in shared Redis.
# NEXORA_API_RATE_LIMIT_REQUESTS=120
# NEXORA_API_RATE_LIMIT_WINDOW_SECONDS=60

# Observability: without these the API exports no traces and serves no /metrics.
# NEXORA_OTEL_EXPORTER_ENDPOINT=http://collector:4318/v1/traces
# NEXORA_OTEL_SAMPLE_RATIO=1.0
# NEXORA_METRICS_TOKEN must be at least 32 characters; generate one locally.
# NEXORA_METRICS_TOKEN=replace-locally-never-commit-0000
# NEXORA_LOG_LEVEL=INFO

# Agent worker (opt-in: docker compose --profile worker up). Without a runtime config
# and a provider credential the worker refuses to start.
# NEXORA_WORKER_RUNTIME_CONFIG=./infra/worker/runtime.json
# NEXORA_OPENAI_API_KEY=replace-locally-never-commit
# Signing secret for spend alert webhooks, required only when the worker runtime
# configuration declares spend_alert_webhook. At least 32 characters.
# NEXORA_SPEND_ALERT_SIGNING_SECRET=replace-locally-never-commit

# Integration vault (Settings -> Integrations). Master keys are a JSON object mapping a
# key identifier to a base64 256-bit key; several may be listed so a rotation can still
# read credentials sealed under the previous one. Without them the API refuses to store
# a tenant credential rather than keeping it readable. Generate one locally with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# NEXORA_SECRET_VAULT_KEYS={"local-1":"replace-locally-never-commit"}
# NEXORA_SECRET_VAULT_ACTIVE_KEY=local-1

# OAuth application registrations per connector. Client secrets belong to the operator
# and never reach the database, a tenant or an agent.
# NEXORA_INTEGRATION_OAUTH_CLIENTS={"instagram":{"client_id":"...","client_secret":"replace-locally-never-commit","redirect_uri":"http://localhost:3000/auth/integrations/callback"}}

# Platform administrators run the standard agent catalog (Agent Studio). Membership is
# deployment configuration: no API call and no workspace role grants it. Comma separated
# verified token subjects.
# NEXORA_PLATFORM_ADMIN_SUBJECTS=
