{
  "id": "nexora.reporting",
  "slug": "reporting",
  "name": "Reporting & Analytics",
  "description": "Builds one unified report across whichever analytics, search, social and advertising sources a workspace has connected. Works with any subset, including none.",
  "category": "analytics",
  "icon": "chart",
  "version": "1.0.0",
  "min_runtime_version": "1.0.0",
  "status": "stable",
  "channel": "stable",
  "changelog": "First stable release: cross-channel reporting over every connected source.",
  "system_instructions": "You produce reports for a business across the channels it has connected.\n\nReport only on sources that are actually connected and returned data. Name every source you used and state explicitly which requested channels were unavailable rather than silently omitting them.\n\nCompare like with like: state the period, the timezone and the metric definition behind each number. Where two sources disagree, show both and explain the likely reason instead of picking one.\n\nYou are read-only. You never change a campaign, a budget or a published asset.",
  "model_policy": {
    "primary": "economical",
    "escalation": "advanced",
    "fallback": "default"
  },
  "reasoning": {
    "effort": "medium",
    "max_steps": 16,
    "escalate_after_steps": 8
  },
  "required_integrations": [],
  "optional_integrations": [
    "google-analytics",
    "google-search-console",
    "instagram",
    "facebook",
    "meta-ads",
    "google-ads"
  ],
  "required_tools": [],
  "optional_tools": [
    "google-analytics.reports.read",
    "google-search-console.search-analytics.read",
    "instagram.insights.read",
    "facebook.insights.read",
    "meta-ads.insights.read",
    "google-ads.insights.read"
  ],
  "capabilities": [
    "reporting.sources.discover",
    "reporting.metrics.read",
    "reporting.report.compose",
    "reporting.anomaly.detect"
  ],
  "permissions": [
    "workspace.read",
    "knowledge.read"
  ],
  "approval_required": [],
  "memory": {
    "enabled": true,
    "scope": "agent",
    "retention_days": 180,
    "max_items": 300
  },
  "rag": {
    "enabled": true,
    "top_k": 6,
    "min_score": 0.2,
    "source_tags": [
      "reporting"
    ]
  },
  "budget": {
    "max_run_micros": 3000000,
    "daily_micros": 60000000,
    "max_tokens_per_run": 300000
  },
  "rate_limits": {
    "runs_per_hour": 40,
    "tool_calls_per_run": 60
  },
  "settings_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "default_period_days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 365
      },
      "timezone": {
        "type": "string",
        "maxLength": 200
      },
      "currency": {
        "type": "string",
        "maxLength": 3
      },
      "include_channels": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 200
        },
        "maxItems": 20
      }
    }
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "task": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "required": [
      "task"
    ]
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "summary": {
        "type": "string",
        "maxLength": 2000
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  }
}
