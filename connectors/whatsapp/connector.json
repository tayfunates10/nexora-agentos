{
  "id": "whatsapp",
  "name": "WhatsApp Business",
  "category": "messaging",
  "icon": "message",
  "description": "WhatsApp Business Cloud API: read conversations and send template or session messages from a registered business number.",
  "version": "1.0.0",
  "status": "beta",
  "auth": "bearer_token",
  "capabilities": [
    "messages.read",
    "messages.send",
    "templates.read"
  ],
  "test_capability": "templates.read",
  "scopes": [],
  "credential_fields": [
    {
      "key": "access_token",
      "label": "System user access token",
      "secret": true,
      "required": true
    },
    {
      "key": "phone_number_id",
      "label": "Phone number ID",
      "secret": false,
      "required": true
    },
    {
      "key": "business_account_id",
      "label": "Business account ID",
      "secret": false,
      "required": false
    }
  ],
  "base_url": "https://graph.facebook.com",
  "credential_placement": {
    "kind": "bearer_header",
    "value_field": "access_token"
  },
  "endpoints": [
    {
      "capability": "templates.read",
      "method": "GET",
      "path": "/v21.0/me"
    }
  ]
}
